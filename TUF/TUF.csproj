<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\CanonicalJson\CanonicalJson.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NSec.Cryptography" />
    <PackageReference Include="Serde" />
  </ItemGroup>

  <!-- Optional hardware signing dependencies 
       Uncomment when implementing full PKCS#11 support:
  <ItemGroup Condition="'$(EnableHardwareSigning)' == 'true' OR '$(Configuration)' == 'Release'">
    <PackageReference Include="Pkcs11Interop" />
  </ItemGroup>
  -->

</Project>
