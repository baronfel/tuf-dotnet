{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    }
  },
  "TUF": {
    "MetadataUrl": "https://example.com/metadata",
    "RootKeyPath": "/app/trusted/root.json",
    "DownloadsDir": "/app/downloads",
    "MetadataDir": "/app/metadata",
    "MaxMetadataBytes": 1048576,
    "MaxTargetBytes": 104857600
  }
}