{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TUF": "Information"
    }
  },
  "AllowedHosts": "*",
  "Tuf": {
    "RepositoryUrl": "https://example.com/tuf-repo",
    "MetadataDirectory": "./tuf-cache/metadata",
    "TargetsDirectory": "./tuf-cache/targets",
    "RefreshIntervalMinutes": 30,
    "MaxMetadataAgeHours": 24
  }
}