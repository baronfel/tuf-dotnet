{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "TUF": "Debug",
      "AspNetCoreIntegration": "Debug"
    }
  },
  "Tuf": {
    "RepositoryUrl": "https://example.com/tuf-repo",
    "MetadataDirectory": "./dev-tuf-cache/metadata",
    "TargetsDirectory": "./dev-tuf-cache/targets",
    "RefreshIntervalMinutes": 5,
    "MaxMetadataAgeHours": 1
  }
}